# MySQL initialization
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=forum
MYSQL_USER=lifeqa
MYSQL_PASSWORD=change_me_app
MYSQL_HOST_PORT=3306

# Local Spring Boot startup
DB_URL=jdbc:mysql://localhost:3306/forum?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=lifeqa
DB_PASSWORD=change_me_app

# Local Redis and Kafka startup
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_HOST_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_GROUP_ID=forum-notification-consumer
KAFKA_HOST_PORT=9092

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://127.0.0.1:3000

# Optional OSS upload
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_DOMAIN=

# Optional frontend map support (compiled into the frontend image)
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
